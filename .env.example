NODE_ENV=development
PORT=4000
DATABASE_URL="postgresql://bhumara:bhumara_dev@localhost:5432/bhumara?schema=public"
REDIS_URL="redis://localhost:6379"
# Auth
JWT_ACCESS_SECRET="ganti-dengan-secret-acak-panjang"
JWT_REFRESH_SECRET="ganti-dengan-secret-acak-panjang-lain"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"
# CORS
FRONTEND_ORIGIN="http://localhost:3000"
# Object storage (MinIO lokal)
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_BUCKET="bhumara"
# Integrasi (isi saat siap; adapter aktif via env)
INSTAGRAM_ACCESS_TOKEN=""
YOUTUBE_API_KEY=""
YOUTUBE_CHANNEL_ID=""
ROBLOX_PLACE_ID=""
